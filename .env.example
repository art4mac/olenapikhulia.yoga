# Copy to .env. ENVIRONMENT is the only switch: it names the stack and picks the
# compose file, so `docker compose up -d` needs no flags.
#
# local — nginx over ./site on the loopback (docker-compose.local.yml)
# The coventpro stack (docker-compose.yml) is deployed by Portainer from git and
# is not meant to run from here.
ENVIRONMENT=local
COMPOSE_PROJECT_NAME=${ENVIRONMENT}-olenapikhulia
COMPOSE_FILE=docker-compose.${ENVIRONMENT}.yml

# host port for the local preview (8080 is usually taken by Docker Desktop)
SITE_PORT=8081

# down mode — true serves nothing but the holding page (down/index.html): the
# site's own loader, with a fill that never finishes. false serves the site.
# On the host stacks this is a Portainer stack variable; flip it and redeploy.
DOWN_MODE=false

# base URL this environment answers on. It fills the __SITE_URL__ token in the
# pages (canonical + share card) through nginx, so a share card always points at
# the host that served it. On the host stacks the compose default is the right
# value; override it with a Portainer stack variable if a host ever changes.
SITE_URL=http://localhost:8081
